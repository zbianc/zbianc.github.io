        &lt;img
          class=&#34;my-0 rounded-md&#34;
          srcset=&#34;
          /blogs/star-ccm&amp;#43;/ccmblog1/ccm1/ccmb8_hu18117542730543952014.png 330w,
          /blogs/star-ccm&amp;#43;/ccmblog1/ccm1/ccmb8_hu15553813195175815651.png 660w,
          /blogs/star-ccm&amp;#43;/ccmblog1/ccm1/ccmb8_hu14027433483711653302.png 1024w,
          /blogs/star-ccm&amp;#43;/ccmblog1/ccm1/ccmb8_hu15918894288630353270.png 2x&#34;
