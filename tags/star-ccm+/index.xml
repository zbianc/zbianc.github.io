          alt=&#34;&#34;
        /&gt;
  
  
  &lt;/figure&gt;

&lt;figure&gt;
        &lt;img
          class=&#34;my-0 rounded-md&#34;
          srcset=&#34;
          /blogs/star-ccm&amp;#43;/ccmblog1/ccm1/ccmb6_hu9875356244992163979.png 330w,
          /blogs/star-ccm&amp;#43;/ccmblog1/ccm1/ccmb6_hu14952156097744149459.png 660w,
          /blogs/star-ccm&amp;#43;/ccmblog1/ccm1/ccmb6_hu5711390635659366437.png 1024w,
          /blogs/star-ccm&amp;#43;/ccmblog1/ccm1/ccmb6_hu13716654540520372691.png 2x&#34;
